{
  "name": "@adyton/capacitor-keystore",
  "version": "1.0.0",
  "description": "Capacitor plugin for Android Keystore P-256 ECDH + vault key sealing (PAK)",
  "main": "dist/plugin.cjs.js",
  "module": "dist/plugin.esm.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/plugin.esm.js",
      "require": "./dist/plugin.cjs.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["android", "dist", "src"],
  "peerDependencies": {
    "@capacitor/core": ">=8.0.0"
  },
  "keywords": ["capacitor", "plugin", "android", "keystore", "ecdh"],
  "capacitor": {
    "ios": { "src": "ios" },
    "android": { "src": "android" }
  },
  "scripts": {
    "build": "tsc",
    "verify:android": "cd android && ./gradlew clean build"
  },
  "devDependencies": {
    "@capacitor/core": "^8.4.0",
    "typescript": "^5.7.2"
  }
}
